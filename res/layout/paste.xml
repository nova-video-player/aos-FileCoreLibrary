<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="0dip"
    android:paddingLeft="16dip"
    android:paddingRight="16dip"
    android:paddingTop="16dip" >

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nhaasgroteskdspro_65md"
        android:ellipsize="end"
        android:maxHeight="160dip"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/green_accent"
        android:layout_below="@id/message"
        android:layout_marginBottom="4dip"
        android:layout_marginTop="16dip"
        android:clickable="false"
        android:focusable="false" />

    <ProgressBar
        android:id="@+id/progress_small"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/green_accent"
        android:layout_below="@id/progress"
        android:layout_marginRight="8dip"
        android:layout_marginTop="4dip" />

    <TextView
        android:id="@+id/progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nhaasgroteskdspro_65md"
        android:layout_marginTop="4dip"
        android:layout_below="@id/progress"
        android:layout_toRightOf="@id/progress_small"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <CheckBox
        android:id="@+id/open_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nhaasgroteskdspro_65md"
        android:buttonTint="@color/checkbox_tint"
        android:layout_marginTop="8dip"
        android:layout_below="@id/progress_text"
        android:text="@string/open_file_after_download" />

</RelativeLayout>